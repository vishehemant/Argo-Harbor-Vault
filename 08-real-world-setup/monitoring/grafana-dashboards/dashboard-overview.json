{
  "__comment": "Grafana Dashboard — Harbor + Vault + Argo CD Overview",
  "__usage": "Import this JSON into Grafana: Dashboards > Import > Upload JSON",
  "dashboard": {
    "title": "Harbor + Vault + Argo CD Overview",
    "tags": ["harbor", "vault", "argocd", "cicd"],
    "timezone": "browser",
    "panels": [
      {
        "__comment": "Panel 1: Argo CD Application Status",
        "title": "Argo CD — Application Sync Status",
        "type": "stat",
        "targets": [
          {
            "expr": "count(argocd_app_info{sync_status='Synced'})",
            "legendFormat": "Synced"
          },
          {
            "expr": "count(argocd_app_info{sync_status='OutOfSync'})",
            "legendFormat": "OutOfSync"
          }
        ],
        "description": "Number of apps in Synced vs OutOfSync state"
      },
      {
        "__comment": "Panel 2: Argo CD Sync Duration",
        "title": "Argo CD — Sync Duration (p95)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(argocd_app_reconcile_bucket[5m])) by (le, name))",
            "legendFormat": "{{ name }}"
          }
        ],
        "description": "95th percentile of sync duration per application"
      },
      {
        "__comment": "Panel 3: Harbor Image Push/Pull Rate",
        "title": "Harbor — Image Push/Pull Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(harbor_project_pull_count_total[5m])",
            "legendFormat": "{{ project_name }} pulls/s"
          },
          {
            "expr": "rate(harbor_project_push_count_total[5m])",
            "legendFormat": "{{ project_name }} pushes/s"
          }
        ]
      },
      {
        "__comment": "Panel 4: Harbor Vulnerability Summary",
        "title": "Harbor — Vulnerabilities by Severity",
        "type": "bargauge",
        "targets": [
          {
            "expr": "harbor_project_artifact_dangerous_count",
            "legendFormat": "{{ project_name }} critical/high"
          }
        ],
        "description": "Images with critical or high vulnerabilities per project"
      },
      {
        "__comment": "Panel 5: Vault Seal Status",
        "title": "Vault — Seal Status",
        "type": "stat",
        "targets": [
          {
            "expr": "vault_core_unsealed",
            "legendFormat": "Unsealed"
          }
        ],
        "description": "1 = unsealed (healthy), 0 = sealed (CRITICAL)"
      },
      {
        "__comment": "Panel 6: Vault Token Creation Rate",
        "title": "Vault — Token Creation Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(vault_token_create_count[5m])",
            "legendFormat": "tokens/s"
          }
        ]
      },
      {
        "__comment": "Panel 7: Vault Secret Read Rate",
        "title": "Vault — Secret Read Rate by Path",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(vault_secret_kv_count[5m])",
            "legendFormat": "{{ mount_point }}"
          }
        ],
        "description": "Rate of secret reads — useful for detecting unusual access patterns"
      },
      {
        "__comment": "Panel 8: Pod Restart Count",
        "title": "Application — Pod Restarts",
        "type": "table",
        "targets": [
          {
            "expr": "kube_pod_container_status_restarts_total{namespace=~'myapp-.*'} > 0",
            "legendFormat": "{{ namespace }}/{{ pod }}"
          }
        ]
      }
    ]
  },
  "__instructions": [
    "1. Install kube-prometheus-stack: helm install kube-prometheus prometheus-community/kube-prometheus-stack -n monitoring --create-namespace",
    "2. Apply ServiceMonitors: kubectl apply -f ../prometheus/service-monitors.yaml",
    "3. Apply Alert Rules: kubectl apply -f ../prometheus/alert-rules.yaml",
    "4. Port-forward Grafana: kubectl port-forward svc/kube-prometheus-grafana -n monitoring 3000:80",
    "5. Login: admin / prom-operator",
    "6. Import this dashboard: Dashboards > Import > Upload JSON > select this file"
  ]
}
